---
import { RESULTS, RESULTS_VISIBLE_COUNT } from "@data/content";

const visible = RESULTS.slice(0, RESULTS_VISIBLE_COUNT);
const rest = RESULTS.slice(RESULTS_VISIBLE_COUNT);
---

<section id="results" class="section-sm" aria-labelledby="results-heading">
  <div class="container">
    <h2 id="results-heading">Results</h2>
    <div class="stat-grid">
      {
        visible.map((r) => (
          <div class="stat-card">
            <span class="stat-value stat-number">{r.value}</span>
            <span class="stat-label">{r.label}</span>
            <span class="stat-attribution">{r.attribution}</span>
          </div>
        ))
      }
    </div>
    {
      rest.length > 0 && (
        <>
          <div class="stat-grid stat-grid-extra" id="results-extra" hidden>
            {rest.map((r) => (
              <div class="stat-card">
                <span class="stat-value stat-number">{r.value}</span>
                <span class="stat-label">{r.label}</span>
                <span class="stat-attribution">{r.attribution}</span>
              </div>
            ))}
          </div>
          <button type="button" id="results-toggle" class="results-toggle" aria-expanded="false" aria-controls="results-extra">
            Show more
          </button>
        </>
      )
    }
  </div>
</section>

<style>
  #results-heading { margin-bottom: var(--space-8); }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: var(--space-6); }
  .stat-grid-extra { margin-top: var(--space-6); }
  .stat-card { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-lg); }
  .stat-value { font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); font-weight: var(--weight-bold); color: var(--color-primary); line-height: 1; }
  .stat-attribution { font-size: var(--text-xs); color: var(--color-text-muted); }
  .results-toggle { margin-top: var(--space-8); padding: var(--space-3) var(--space-6); background: transparent; border: var(--border-width) solid var(--color-primary); color: var(--color-primary); font-weight: var(--weight-medium); font-size: var(--text-sm); border-radius: var(--radius-md); cursor: pointer; }
  .results-toggle:hover { background-color: var(--color-primary); color: #fff; }
</style>

<script is:inline>
  (function () {
    function attach() {
      var btn = document.getElementById("results-toggle");
      var extra = document.getElementById("results-extra");
      if (!btn || !extra) return;
      btn.addEventListener("click", function () {
        var wasHidden = extra.hidden;
        extra.hidden = !wasHidden;
        btn.setAttribute("aria-expanded", String(wasHidden));
        btn.textContent = wasHidden ? "Show less" : "Show more";
      });
    }
    attach();
    document.addEventListener("astro:after-swap", attach);
  })();
</script>
