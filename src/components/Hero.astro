---
import { CONTACT, HERO, SHOW_PHOTO, SITE } from "@data/content";
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-inner">
    <div class="hero-content">
      <h1 id="hero-heading" class="hero-name">{HERO.name}</h1>
      <p class="hero-role">{HERO.role}</p>
      <p class="hero-qualifier">{HERO.qualifier}</p>
      <p class="hero-value">{HERO.valueLine}</p>
      <p class="hero-bridge">{HERO.bridge}</p>
      <p class="hero-proof">{HERO.proof}</p>

      <div class="hero-actions">
        <a href={CONTACT.resumeRequestHref} class="btn btn-primary">Request Resume</a>
        <a href={CONTACT.emailHref} class="btn btn-outline">Email Me</a>
        <a
          href={CONTACT.linkedin}
          class="hero-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Yennyfer Pollock on LinkedIn (opens in a new tab)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
          LinkedIn
        </a>
      </div>

      <p class="hero-chips">{HERO.credibilityChips.join("  ·  ")}</p>
    </div>

    {
      SHOW_PHOTO && (
        <div class="hero-photo">
          <img
            src={`${SITE.base}/assets/profile.webp`}
            alt="Portrait of Yennyfer Pollock"
            width="480"
            height="480"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero { padding-block: var(--space-20); background-color: #0b1f3a; }
  .hero-inner { display: grid; grid-template-columns: 1fr auto; gap: var(--space-12); align-items: center; }
  .hero-content { max-width: 42rem; }
  .hero-name { font-size: var(--text-4xl); font-weight: 800; line-height: var(--leading-tight); color: #fff; margin-bottom: var(--space-3); }
  .hero-role { font-size: var(--text-xl); font-weight: var(--weight-semibold); color: #fff; margin-bottom: var(--space-2); }
  .hero-qualifier { font-size: var(--text-sm); color: #b7c4d9; margin-bottom: var(--space-6); }
  .hero-value { font-size: var(--text-xl); font-weight: var(--weight-semibold); color: #c89b3c; margin-bottom: var(--space-4); }
  .hero-bridge { font-size: var(--text-lg); color: #dbe3ee; line-height: var(--leading-relaxed); margin-bottom: var(--space-4); }
  .hero-proof { color: #b7c4d9; line-height: var(--leading-relaxed); margin-bottom: var(--space-8); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin-bottom: var(--space-6); }
  .hero-actions .btn-primary { background-color: #c89b3c; color: #0b1f3a; }
  .hero-actions .btn-primary:hover { background-color: #b8863b; color: #0b1f3a; }
  .hero-actions .btn-outline { color: #fff; border-color: #fff; }
  .hero-actions .btn-outline:hover { background-color: #fff; color: #0b1f3a; }
  .hero-link { display: inline-flex; align-items: center; gap: var(--space-2); color: #c89b3c; font-weight: var(--weight-medium); font-size: var(--text-sm); text-decoration: none; }
  .hero-link:hover { color: var(--color-accent-hover); text-decoration: underline; }
  .hero-chips { font-size: var(--text-sm); color: #8fa3c4; }
  .hero-photo img { width: 220px; height: 220px; object-fit: cover; border-radius: var(--radius-lg); border: 3px solid #c89b3c; box-shadow: var(--shadow-lg); }
  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-photo { order: -1; }
    .hero-photo img { width: 160px; height: 160px; }
  }
  @media (max-width: 640px) {
    .hero { padding-block: var(--space-12); }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn { width: 100%; text-align: center; }
    .hero-link { justify-content: center; }
  }
</style>
