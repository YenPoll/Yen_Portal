---
import { AI_WORK, CERTIFICATIONS, TOOLS } from "@data/content";
---

<section id="how-i-work" class="section-sm how-section" aria-labelledby="how-i-work-heading">
  <div class="container">
    <h2 id="how-i-work-heading">How I Work</h2>
    <div class="how-grid">
      <div>
        <h3>Tools I work in</h3>
        <p class="muted">{TOOLS.join(" · ")}</p>
      </div>
      <div>
        <h3>Working with AI</h3>
        {AI_WORK.paragraphs.map((p) => <p class="muted ai-p">{p}</p>)}
      </div>
    </div>
    <p class="certifications">{CERTIFICATIONS.join(" · ")}</p>
  </div>
</section>

<style>
  .how-section { background-color: var(--color-bg-alt); }
  #how-i-work-heading { margin-bottom: var(--space-8); }
  .how-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-10); }
  .how-grid h3 { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .muted { color: var(--color-text-muted); }
  .ai-p { margin-bottom: var(--space-3); }
  .certifications { margin-top: var(--space-8); padding-top: var(--space-6); border-top: var(--border-width) solid var(--color-border); font-size: var(--text-sm); color: var(--color-text-muted); }
  @media (max-width: 768px) { .how-grid { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
