---
import { ABOUT } from "@data/content";
---

<section id="about" class="section-sm" aria-labelledby="about-heading">
  <div class="container">
    <div class="about-inner">
      <h2 id="about-heading">The bridge</h2>
      {ABOUT.paragraphs.map((p) => <p class="about-p">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .about-inner { max-width: var(--content-width); }
  #about-heading { margin-bottom: var(--space-6); }
  .about-p { color: var(--color-text-muted); margin-bottom: var(--space-4); }
  .about-p:first-of-type { color: var(--color-text); font-size: var(--text-lg); }
</style>
