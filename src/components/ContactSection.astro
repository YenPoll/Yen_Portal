---
import { CONTACT, CONTACT_SECTION } from "@data/content";
---

<section id="contact" class="section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="contact-inner">
      <h2 id="contact-heading">{CONTACT_SECTION.heading}</h2>
      {CONTACT_SECTION.paragraphs.map((p) => <p class="contact-p">{p}</p>)}

      <ul class="contact-details" role="list">
        <li><a href={CONTACT.emailHref}>{CONTACT.email}</a></li>
        <li>
          <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Yennyfer Pollock on LinkedIn (opens in a new tab)">{CONTACT.linkedinDisplay}</a>
        </li>
        <li class="contact-location">{CONTACT.location}</li>
      </ul>

      <p class="contact-note">{CONTACT_SECTION.resumeNote}</p>
      <a href={CONTACT.resumeRequestHref} class="btn btn-primary">Request Resume</a>
    </div>
  </div>
</section>

<style>
  .contact-inner { max-width: var(--content-width); }
  #contact-heading { margin-bottom: var(--space-6); }
  .contact-p { color: var(--color-text-muted); font-size: var(--text-lg); margin-bottom: var(--space-4); }
  .contact-details { list-style: none; padding: 0; margin: var(--space-8) 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .contact-details a { font-weight: var(--weight-medium); }
  .contact-location { color: var(--color-text-muted); font-size: var(--text-sm); }
  .contact-note { color: var(--color-text-muted); margin-bottom: var(--space-4); }
</style>
