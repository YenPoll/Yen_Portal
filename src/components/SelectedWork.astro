---
import { CASE_STUDIES, COMPANY_LINKS } from "@data/content";
---

<section id="selected-work" class="section" aria-labelledby="selected-work-heading">
  <div class="container">
    <h2 id="selected-work-heading">Selected Work</h2>
    <div class="case-study-list">
      {
        CASE_STUDIES.map((cs) => (
          <article class="case-study-card">
            <header>
              <h3>{cs.title}</h3>
              <p class="case-study-meta">
                {COMPANY_LINKS[cs.company] ? (
                  <a href={COMPANY_LINKS[cs.company]} target="_blank" rel="noopener noreferrer" aria-label={`${cs.company} (opens in a new tab)`}>{cs.company}</a>
                ) : (
                  cs.company
                )}{" "}
                · {cs.period}
              </p>
            </header>
            <div class="case-study-block"><p class="case-study-label">The problem</p><p>{cs.problem}</p></div>
            <div class="case-study-block"><p class="case-study-label">What I did</p><p>{cs.whatIDid}</p></div>
            <div class="case-study-block"><p class="case-study-label">The result</p><p>{cs.result}</p></div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  #selected-work-heading { margin-bottom: var(--space-8); }
  .case-study-list { display: flex; flex-direction: column; gap: var(--space-8); }
  .case-study-card { padding: var(--space-8); border-left: 3px solid var(--color-accent); background-color: var(--color-bg-alt); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  .case-study-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-1); }
  .case-study-meta { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-6); }
  .case-study-meta a { color: var(--color-text-muted); text-decoration-color: var(--color-border); }
  .case-study-meta a:hover { color: var(--color-primary); }
  .case-study-block { margin-bottom: var(--space-5); }
  .case-study-block:last-child { margin-bottom: 0; }
  .case-study-label { font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin-bottom: var(--space-2); }
  @media (max-width: 640px) { .case-study-card { padding: var(--space-5); } }
</style>
