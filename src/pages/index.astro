---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import About from "@components/About.astro";
import WhatIDo from "@components/WhatIDo.astro";
import Results from "@components/Results.astro";
import SelectedWork from "@components/SelectedWork.astro";
import Experience from "@components/Experience.astro";
import HowIWork from "@components/HowIWork.astro";
import ContactSection from "@components/ContactSection.astro";
import Seo from "@components/Seo.astro";
import { CONTACT, SITE } from "@data/content";
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <Seo
    type="Person"
    data={{
      name: SITE.author,
      jobTitle: SITE.role,
      email: CONTACT.email,
      url: SITE.url,
      address: { "@type": "PostalAddress", addressCountry: "US" },
      sameAs: [CONTACT.linkedin],
    }}
  />

  <Hero />
  <About />
  <WhatIDo />
  <Results />
  <SelectedWork />
  <Experience />
  <HowIWork />
  <ContactSection />
</BaseLayout>
